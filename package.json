{
  "name": "react-frontend",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@catalogue/web",
    "build": "npm run build --workspace=@catalogue/web",
    "test": "npm run test --workspace=@catalogue/web",
    "typecheck": "npm run typecheck --workspace=@catalogue/web",
    "test:e2e": "npm run test:e2e --workspace=@catalogue/web",
    "test:all": "npm test && npm run test:e2e"
  }
}
